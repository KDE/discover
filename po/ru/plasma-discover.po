msgstr "Запрошенное приложение не найдено ни в одном из репозиториев"

#: discover/DiscoverObject.cpp:424
#, kde-kuit-format
msgctxt ""
"@info %1 is an additional error reference and %3 is the name of the "
"operating system"
msgid ""
"(No entry for %1)<nl/><nl/>Please <link url='%2'>report this issue to %3.</"
"link>"
msgstr ""
"(Нет ни одной записи о %1)<nl/><nl/><link url='%2'>Сообщите %3 об этой "
"ситуации</link>."

