#: discover/DiscoverObject.cpp:216
#, kde-kuit-format
msgctxt "@info:usagetip %1 is the distro name"
msgid ""
"Support for managing packages from %1 is incomplete; you may experience any "
"number of problems. Do not report bugs to KDE. It is highly recommended to "
"uninstall the <resource>packagekit-qt6</resource> package and use Discover "
"only to manage Flatpaks, Snaps, and Add-Ons.<para>%1 maintainers recommended "
"instead using the <command>pacman</command> command-line tool to manage "
"packages.</para>"
msgstr ""
"Understøttelsen for håndering af pakker fra %1 er ufærdig; du kan opleve "
"flere forskellige problemer. Rapportér ikke fejl til KDE. Det er stærkt "
"anbefalet at afinstallere <resource>qt6</resource> pakke-sættet og kun "
"benytte discover til håndtering af Flatpaks, Snaps og tilføjelsesprogrammer."
"<para>%1 udviklere anbefaleder i stedet at bruge kommandolinje-værktøjet "
"<command>pacman</command> til at håndtere pakker med.</para>"

