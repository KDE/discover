#: kcm/ui/main.qml:65
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Software updates will be downloaded automatically when they become "
"available. Updates for applications will be installed immediately, while "
"updates for the system will be installed the next time it’s restarted."
msgstr ""
"Uppdateringar av programvara laddas automatiskt ner när de blir "
"tillgängliga. Uppdateringar av program installeras omedelbart, medan "
"uppdateringar av systemet installeras nästa gång det startas om."

