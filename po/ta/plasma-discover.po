#: discover/DiscoverObject.cpp:197
#, kde-format
msgctxt "@title %1 is the name"
msgid ""
"%1 is not configured for installing apps through Discover—only app add-ons"
msgstr ""
"டிஸ்கவர் மூலம் செயலிகளை நிறுவுமாறு %1 அமைக்கபடவில்லை—செயலிகளுக்கான துணைநிரல்களை "
"மட்டுமே நிறுவ முடியும்."

#: discover/DiscoverObject.cpp:199
#, kde-kuit-format
msgctxt "@info:usagetip %2 is the name of the operating system"
msgid ""
"To use Discover for apps, install your preferred module on the "
"<interface>Settings</interface> page, under <interface>Missing Backends</"
"interface>.<nl/><nl/>Please <link url='%1'>report this issue to %2.</link>"
msgstr ""
"டிஸ்கவர் மூலம் செயலிகளை நிறுவ, <interface>அமைப்புகள்</interface> பக்கத்திலுள்ள "
"<interface>இல்லாத பின்நிலைகள்</interface> பகுதியில் நீங்கள் விரும்பும் கூறை நிறுவ‍வும்."
"nl/><nl/>இந்த சிக்கலை %2-க்கு <link url='%1'>தெரிவிக்கவும்</link>."

#: discover/DiscoverObject.cpp:206
#, kde-kuit-format
msgctxt ""
"@info:usagetip %1 is the distro name; in this case it always contains 'Arch "
"Linux'"
msgid ""
"To use Discover for apps, install <link url='https://wiki.archlinux.org/"
"title/Flatpak#Installation'>Flatpak</link> using the <command>pacman</"
"command> package manager.<nl/><nl/> Review <link url='https://archlinux.org/"
"packages/extra/x86_64/discover/'>%1's packaging for Discover</link>"
msgstr ""
"செயலிகளை டிஸ்கவர் மூலம் நிறுவ, <link url='https://wiki.archlinux.org/title/"
"Flatpak#Installation'>Flatpak</link> தனை <command>pacman</command> தொகுப்பு "
"மேலாளியால் நிறுவ‍வும்.<nl/><nl/><link url='https://archlinux.org/packages/extra/"
"x86_64/discover/'>டிஸ்கவருக்கு %1 வழங்கும் தொகுப்பை</link> பார்க்கவும்."

#: discover/DiscoverObject.cpp:216
#, kde-kuit-format
msgctxt "@info:usagetip %1 is the distro name"
msgid ""
"Support for managing packages from %1 is incomplete; you may experience any "
"number of problems. Do not report bugs to KDE. It is highly recommended to "
"uninstall the <resource>packagekit-qt6</resource> package and use Discover "
"only to manage Flatpaks, Snaps, and Add-Ons.<para>%1 maintainers recommended "
"instead using the <command>pacman</command> command-line tool to manage "
"packages.</para>"
msgstr ""

#: discover/DiscoverObject.cpp:305
#, kde-format
msgid "Could not find category '%1'"
msgstr "'%1 என்ற பகுப்பை கண்டுபிடிக்க முடியவில்லை"

#: discover/DiscoverObject.cpp:327
#, kde-format
msgid "Trying to open inexisting file '%1'"
msgstr "'%1' எனும் இல்லாத கோப்பின் திறப்பு முயற்சிக்கப்பட்டது"

#: discover/DiscoverObject.cpp:349
#, kde-format
msgid ""
"Cannot interact with flatpak resources without the flatpak backend %1. "
"Please install it first."
msgstr ""
"%1 எனும் flatpak பின்நிலை இல்லாமல் ஃபலாட்பாக்குகளைக் கையாள முடியாது. அதை முதலில் "
"நிறுவுங்கள்."

#: discover/DiscoverObject.cpp:353
#, kde-format
msgid "Could not open %1"
msgstr "%1 தனை திறக்க முடியவில்லை"

#: discover/DiscoverObject.cpp:418
#, kde-format
msgid "Please make sure Snap support is installed"
msgstr "Snap ஆதரவு நிறுவப்பட்டுள்ளதா என்பதை சரிபாருங்கள்"

#: discover/DiscoverObject.cpp:421
#, kde-format
msgid ""
"The requested application could not be found in any available software "
"repositories"
msgstr "கோரிய செயலியை இயக்கப்பட்டுள்ள நிரல்கிடங்குகளில் கண்டுபிடிக்க முடியவில்லை."

#: discover/DiscoverObject.cpp:424
#, kde-kuit-format
msgctxt ""
"@info %1 is an additional error reference and %3 is the name of the "
"operating system"
msgid ""
"(No entry for %1)<nl/><nl/>Please <link url='%2'>report this issue to %3.</"
"link>"
msgstr ""
"(%1 என்பதற்கு எந்த பதிவும் இல்லை)<nl/><nl/>இதை %3-க்கு <link url='%2'>தெரிவிக்கவும்</"
"link>."

#: discover/DiscoverObject.cpp:515 discover/DiscoverObject.cpp:517
#: discover/main.cpp:120
#, kde-format
msgid "Discover"
msgstr "டிஸ்கவர்"

#: discover/DiscoverObject.cpp:518
#, kde-format
msgid ""
"Discover was closed before certain tasks were done, waiting for it to finish."
msgstr "சில பணிகளை முடிக்குமுன் டிஸ்கவர் மூடப்பட்டது. அவை முடியும்வரை காத்திருங்கள்."

#: discover/main.cpp:34
#, kde-format
msgid "Directly open the specified application by its appstream:// URI."
msgstr "குறிப்பிட்ட செயலியை அதன் appstream:// முகவரி மூலம் திறக்கும்"

#: discover/main.cpp:35
#, kde-format
msgid "Open with a search for programs that can deal with the given mimetype."
msgstr "குறிப்பிட்ட மைம்வகையை கையாளக்கூடிய செயலிகளுக்கான தேடலுடன் திறக்கும்."

#: discover/main.cpp:36
#, kde-format
msgid "Display a list of entries with a category."
msgstr "ஓர் பகுப்பிலுள்ள பதிவுகளை பட்டியலிடும்."

#: discover/main.cpp:37
#, kde-format
msgid "Open Discover in a said mode. Modes correspond to the toolbar buttons."
msgstr ""
"குறிப்பிட்ட பயன்முறையில் டிஸ்கவரைத் திறக்கும். கருவிப்பட்டையிலுள்ள பட்டன்களை ஒத்த "
"பயன்முறைகள் உள்ளன."

#: discover/main.cpp:38
