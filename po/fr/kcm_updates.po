#: kcm/ui/main.qml:37
#, kde-format
msgctxt "@title:group formentry title, completes e.g. … manually"
msgid "Update software:"
msgstr "Mettre à jour les logiciels :"

#: kcm/ui/main.qml:39
#, kde-format
msgctxt "@option:radio completes Update software …"
msgid "Manually"
msgstr "Manuellement"

#: kcm/ui/main.qml:53
#, kde-format
msgctxt "@option:radio completes Update software …"
msgid "Automatically"
msgstr "Automatiquement"

#: kcm/ui/main.qml:65
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Software updates will be downloaded automatically when they become "
"available. Updates for applications will be installed immediately, while "
"updates for the system will be installed the next time it’s restarted."
msgstr ""
"Les mises à jour de logiciels seront téléchargées automatiquement dès que "
"disponibles. Les mises à jour des applications seront installées "
"immédiatement alors que les mises à jour du système seront installées après "
"un redémarrage de l'ordinateur."

#: kcm/ui/main.qml:71
#, kde-format
msgctxt "@title:group"
msgid "Update frequency:"
msgstr "Fréquence de mise à jour :"

#: kcm/ui/main.qml:71
#, kde-format
msgctxt "@title:group"
msgid "Notification frequency:"
msgstr "Fréquence des notifications :"

#: kcm/ui/main.qml:78
#, kde-format
msgctxt "@item:inlistbox"
msgid "Daily"
msgstr "Quotidienne"

#: kcm/ui/main.qml:79
#, kde-format
msgctxt "@item:inlistbox"
msgid "Weekly"
msgstr "Hebdomadaire"

#: kcm/ui/main.qml:80
#, kde-format
msgctxt "@item:inlistbox"
msgid "Monthly"
msgstr "Mensuelle"

#: kcm/ui/main.qml:81
#, kde-format
msgctxt "@item:inlistbox"
msgid "Never"
msgstr "Jamais"

#: kcm/ui/main.qml:118
#, kde-format
msgctxt "@title:group formentry title completes e.g. … After rebooting "
msgid "Apply system updates:"
msgstr "Appliquer les mises à jour du système :"

#: kcm/ui/main.qml:121
#, kde-format
msgctxt ""
"@option:radio part of the logical sentence 'Apply system updates after "
"rebooting'"
msgid "After rebooting"
msgstr "Après le re-démarrage"

#: kcm/ui/main.qml:130
#, kde-format
msgctxt ""
"@info:usagetip The thing being recommended is to use the 'apply updates when "
"rebooting' setting"
msgid "Recommended to maximize system stability"
msgstr "Recommandé pour maximiser la stabilité du système"

#: kcm/ui/main.qml:134
#, kde-format
msgctxt ""
"@option:radio part of the logical sentence 'Apply system updates immediately'"
msgid "Immediately"
msgstr "Immédiatement"

#~ msgid "Use offline updates:"
#~ msgstr "Utiliser les mises à jour hors ligne :"

#~ msgid ""
#~ "Offline updates maximize system stability by applying changes while "
#~ "restarting the system. Using this update mode is strongly recommended."
#~ msgstr ""
#~ "Les mises à jour hors ligne renforcent la stabilité du système, par "
#~ "application des modifications, pendant le re-démarrage du système. "
#~ "L'utilisation de cette mise à jour est fortement recommandée."

#~ msgid "Software Update"
#~ msgstr "Mise à jour des logiciels "

#~ msgid "Configure software update settings"
#~ msgstr "Configurer les paramètres pour les mises à jour de logiciels"
