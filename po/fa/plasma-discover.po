#, kde-format
msgid "Could not open %1"
msgstr "نمی‌توان %1 را باز کرد"

#: discover/DiscoverObject.cpp:418
#, kde-format
msgid "Please make sure Snap support is installed"
msgstr "اطمینان حاصل کنید که پشتیبانی اسنپ نصب شده است"

#: discover/DiscoverObject.cpp:421
#, kde-format
msgid ""
"The requested application could not be found in any available software "
"repositories"
msgstr "برنامه درخواستی در هیچ مخزن نرم‌افزار در دسترسی یافت نشد"

#: discover/DiscoverObject.cpp:424
#, kde-kuit-format
msgctxt ""
"@info %1 is an additional error reference and %3 is the name of the "
"operating system"
msgid ""
"(No entry for %1)<nl/><nl/>Please <link url='%2'>report this issue to %3.</"
"link>"
msgstr ""
"(بدون ورودی برای %1)<nl/><nl/>لطفاً <link url='%2'>این مشکل را به %3 گزارش "
"دهید.</link>"

