#: discover/qml/ApplicationPage.qml:80
#, kde-kuit-format
msgctxt "@info"
msgid ""
"%1 uses one or more licenses not certified as “Free Software” by either the "
"<link url='%2'>Free Software Foundation</link> or the <link url='%3'>Open "
"Source Initiative</link>. This means your freedom to use, study, modify, and "
"share it may be restricted in some ways.<nl/><nl/>Make sure to read the "
"license text and understand any restrictions before using the software.<nl/"
"><nl/>If the license does not even grant access to read the source code, "
"make sure you fully trust the authors, as no one else can verify the "
"trustworthiness and security of its code to ensure that it is not acting "
"against you in hidden ways. More information may be available on <link "
"url='%4'>the application’s website</link>.<nl/><nl/>Learn more at <link "
"url='%5'>%5</link>."
msgstr ""
"%1 користи једну или више лиценци које ни <link url='%2'>Задужбина за "
"слободни софтвер</link> ни <link url='%3'>Иницијатива за отворени код</link> "
"не признају као „слободни софтвер“. То значи да ваша слобода да га "
"користите, проучавате, мијењате и дијелите може бити на неки начин "
"ограничена.<nl/><nl/>Прије коришћења софтвера обавезно прочитајте текст "
"лиценце и схватите сва ограничења.<nl/><nl/>Ако лиценца не даје чак ни "
"приступ за читање изворног кода, будите сигурни да потпуно вјерујете "
"ауторима, јер нико други не може да провјери поузданост и безбједност "
"његовог кода и да се увјери да не ради против вас на скривене начине. Више "
"података можда има на <link url='%4'>веб сајту програма</link>.<nl/><nl/"
">Сазнајте више на <link url='%5'>%5</link>."

