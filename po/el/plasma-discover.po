#: discover/DiscoverObject.cpp:515 discover/DiscoverObject.cpp:517
#: discover/main.cpp:120
#, kde-format
msgid "Discover"
msgstr "Ανακάλυψη"

#: discover/DiscoverObject.cpp:518
#, kde-format
